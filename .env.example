# Groq API Configuration
# Reemplaza con tu clave de API si no usas la variable de entorno
GROQ_API_KEY=gsk_your_groq_api_key_here
# Modelos recomendados de Groq:
# llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768, qwen-2.5-32b
GROQ_API_MODEL=llama-3.3-70b-versatile

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/nexa_insights_db

# Server Port
PORT=8080
